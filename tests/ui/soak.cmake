set(dir "${WORK}/soak")
file(REMOVE_RECURSE "${dir}")
file(MAKE_DIRECTORY "${dir}/libs" "${dir}/ebooks")
file(COPY_FILE "${EXE}" "${dir}/EbookReader.exe")
file(COPY_FILE "${DLL}" "${dir}/libs/eb_mupdf.dll")
file(COPY "${CORPUS}/good/epub" "${CORPUS}/good/txt" DESTINATION "${dir}/ebooks")
execute_process(COMMAND "${dir}/EbookReader.exe" --smoke --smoke-scan RESULT_VARIABLE rc TIMEOUT 40)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "soak scan exited with '${rc}'")
endif()
execute_process(COMMAND "${dir}/EbookReader.exe" --smoke --smoke-soak 1 RESULT_VARIABLE rc TIMEOUT 120)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "soak exited with '${rc}'")
endif()
file(READ "${dir}/data/logs/soak.log" log)
if(NOT log MATCHES "soak: t=1 books=([1-9][0-9]*) pages=([1-9][0-9]*)")
  message(FATAL_ERROR "the soak never opened a book and turned pages")
endif()
file(REMOVE_RECURSE "${dir}")
