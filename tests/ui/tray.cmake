set(dir "${WORK}/tray")
file(REMOVE_RECURSE "${dir}")
file(MAKE_DIRECTORY "${dir}/libs" "${dir}/ebooks")
file(COPY_FILE "${EXE}" "${dir}/EbookReader.exe")
file(COPY_FILE "${DLL}" "${dir}/libs/eb_mupdf.dll")
execute_process(COMMAND powershell -NoProfile -Command
  "$p = Start-Process -FilePath '${dir}/EbookReader.exe' -ArgumentList '--smoke','--smoke-tray' -Wait -PassThru; exit $p.ExitCode"
  RESULT_VARIABLE rc TIMEOUT 30)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "smoke tray exited with '${rc}'")
endif()
file(READ "${dir}/data/logs/app.log" log)
if(log MATCHES "smoke tray failed")
  message(FATAL_ERROR "tray check failed: window not hidden or icon missing")
endif()
if(NOT log MATCHES "tray-ws-kb ([0-9]+) tray-private-kb ([0-9]+)")
  message(FATAL_ERROR "no tray memory measurement in the log")
endif()
set(ws_kb "${CMAKE_MATCH_1}")
message(STATUS "tray-ws-kb ${ws_kb} tray-private-kb ${CMAKE_MATCH_2}")
if(BUDGET GREATER 0 AND ws_kb GREATER BUDGET)
  message(FATAL_ERROR "tray working set ${ws_kb} KB exceeds ${BUDGET} KB")
endif()
file(REMOVE_RECURSE "${dir}")
