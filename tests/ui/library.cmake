set(dir "${WORK}/library")
file(REMOVE_RECURSE "${dir}")
file(MAKE_DIRECTORY "${dir}/libs" "${dir}/ebooks")
file(COPY_FILE "${EXE}" "${dir}/EbookReader.exe")
file(COPY_FILE "${DLL}" "${dir}/libs/eb_mupdf.dll")
file(GLOB subs LIST_DIRECTORIES true "${CORPUS}/good/*")
foreach(s IN LISTS subs)
  file(COPY "${s}" DESTINATION "${dir}/ebooks")
endforeach()
execute_process(COMMAND "${dir}/EbookReader.exe" --smoke --smoke-scan RESULT_VARIABLE rc TIMEOUT 40)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "smoke scan exited with '${rc}'")
endif()
execute_process(COMMAND "${DBCOUNT}" "${dir}/data/library.db" 10 RESULT_VARIABLE rc OUTPUT_VARIABLE out)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "library has too few books (rc=${rc}): ${out}")
endif()
file(GLOB covers "${dir}/data/covers/*.jpg")
if(NOT covers)
  message(FATAL_ERROR "no cover was generated")
endif()
file(REMOVE_RECURSE "${dir}")
