set(dir "${WORK}/single")
set(log_file "${dir}/data/logs/app.log")
file(REMOVE_RECURSE "${dir}")
file(MAKE_DIRECTORY "${dir}/libs" "${dir}/ebooks")
file(COPY_FILE "${EXE}" "${dir}/EbookReader.exe")
file(COPY_FILE "${DLL}" "${dir}/libs/eb_mupdf.dll")
file(COPY_FILE "${BOOK}" "${dir}/book.epub")
file(TO_NATIVE_PATH "${dir}/book.epub" native_book)

execute_process(COMMAND powershell -NoProfile -Command
  "Start-Process -FilePath '${dir}/EbookReader.exe' -ArgumentList '--smoke','--smoke-hold','5000'"
  RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "could not start the first instance")
endif()

set(ready FALSE)
foreach(i RANGE 50)
  if(EXISTS "${log_file}")
    file(READ "${log_file}" log)
    if(log MATCHES "first-paint")
      set(ready TRUE)
      break()
    endif()
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 0.2)
endforeach()
if(NOT ready)
  message(FATAL_ERROR "first instance never painted")
endif()

execute_process(COMMAND "${dir}/EbookReader.exe" --smoke "${native_book}" RESULT_VARIABLE rc TIMEOUT 2)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "second instance exited with '${rc}'")
endif()

set(seen FALSE)
foreach(i RANGE 20)
  file(READ "${log_file}" log)
  string(FIND "${log}" "copydata open ${native_book}" at)
  if(NOT at EQUAL -1)
    set(seen TRUE)
    break()
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 0.2)
endforeach()
if(NOT seen)
  message(FATAL_ERROR "first instance did not log the forwarded path")
endif()

execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 6)
file(REMOVE_RECURSE "${dir}")
