set(dir "${WORK}/badlib")
file(REMOVE_RECURSE "${dir}")
file(MAKE_DIRECTORY "${dir}/libs")
file(COPY_FILE "${EXE}" "${dir}/EbookReader.exe")
file(COPY_FILE "${DLL}" "${dir}/libs/eb_mupdf.dll")
execute_process(COMMAND "${dir}/EbookReader.exe" --smoke RESULT_VARIABLE rc TIMEOUT 8)
if(NOT rc EQUAL 1)
  message(FATAL_ERROR "expected exit code 1, got '${rc}'")
endif()
file(GLOB dumps "${dir}/data/crash/*")
if(dumps)
  message(FATAL_ERROR "unexpected crash dump: ${dumps}")
endif()
file(REMOVE_RECURSE "${dir}")
