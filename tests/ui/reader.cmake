set(dir "${WORK}/reader")
file(REMOVE_RECURSE "${dir}")
file(MAKE_DIRECTORY "${dir}/libs" "${dir}/ebooks")
file(COPY_FILE "${EXE}" "${dir}/EbookReader.exe")
file(COPY_FILE "${DLL}" "${dir}/libs/eb_mupdf.dll")
file(COPY_FILE "${BOOK}" "${dir}/ebooks/book.epub")
execute_process(COMMAND "${dir}/EbookReader.exe" --smoke --smoke-scan RESULT_VARIABLE rc TIMEOUT 40)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "smoke scan exited with '${rc}'")
endif()
execute_process(COMMAND "${dir}/EbookReader.exe" --smoke --smoke-open book.epub RESULT_VARIABLE rc TIMEOUT 40)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "smoke open exited with '${rc}'")
endif()
execute_process(COMMAND "${dir}/EbookReader.exe" --smoke --smoke-open book.epub --smoke-theme RESULT_VARIABLE rc TIMEOUT 40)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "smoke theme exited with '${rc}'")
endif()
file(READ "${dir}/data/logs/app.log" log)
if(NOT log MATCHES "render-opts tint=1 fg=#D0D0D0")
  message(FATAL_ERROR "the dark theme never reached the render request")
endif()
if(NOT log MATCHES "smoke: bookmark added then removed")
  message(FATAL_ERROR "the bookmark toggle did not add and remove a bookmark")
endif()
if(NOT log MATCHES "reader: outline pane [1-9]")
  message(FATAL_ERROR "the outline never reached the side pane")
endif()
execute_process(COMMAND "${DBCOUNT}" "${dir}/data/library.db" 1 progress RESULT_VARIABLE rc OUTPUT_VARIABLE out)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "no reading progress was saved (rc=${rc}): ${out}")
endif()
file(REMOVE_RECURSE "${dir}")
