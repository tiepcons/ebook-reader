# Generates VieNeuPins.h from tools/vieneu_pins.psd1, the single place that lists the SHA-256 of the VieNeu model, the
# sea-g2p dictionary and every voice preset file. Usage: eb_generate_vieneu_pins(<output header>)
function(eb_generate_vieneu_pins out)
  set(src "${CMAKE_SOURCE_DIR}/tools/vieneu_pins.psd1")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${src}")
  file(READ "${src}" txt)
  string(REGEX MATCH "Model = @\{[^}]*Sha256 = '([0-9a-f]+)'" _m "${txt}")
  set(model "${CMAKE_MATCH_1}")
  string(REGEX MATCH "SeaG2pDict = @\{[^}]*Sha256 = '([0-9a-f]+)'" _m "${txt}")
  set(dict "${CMAKE_MATCH_1}")
  string(REGEX MATCH "Manifest = '([0-9a-f]+)'" _m "${txt}")
  set(manifest "${CMAKE_MATCH_1}")
  string(REGEX MATCHALL "'[A-Za-z0-9_]+/[A-Za-z0-9_.]+' = '[0-9a-f]+'" rows "${txt}")
  set(table "")
  foreach(row IN LISTS rows)
    string(REGEX MATCH "'([^']+)' = '([0-9a-f]+)'" _r "${row}")
    string(APPEND table "    {\"${CMAKE_MATCH_1}\", \"${CMAKE_MATCH_2}\"},\n")
  endforeach()
  if(NOT model OR NOT dict OR NOT manifest OR NOT table)
    message(FATAL_ERROR "tools/vieneu_pins.psd1 could not be parsed")
  endif()
  file(GENERATE OUTPUT "${out}" CONTENT
"#pragma once
// Generated by cmake/vieneu_pins.cmake from tools/vieneu_pins.psd1. Do not edit.
#include <string_view>

namespace eb::vieneu::pins {

inline constexpr std::string_view kModel = \"${model}\";
inline constexpr std::string_view kDict = \"${dict}\";
inline constexpr std::string_view kManifest = \"${manifest}\";

struct VoiceFile {
    std::string_view name;
    std::string_view sha256;
};

inline constexpr VoiceFile kVoiceFiles[] = {
${table}};

}
")
endfunction()
