#include <winuser.h>
#include "resource.h"

#pragma code_page(65001)

1 RT_MANIFEST "app.manifest"

IDR_MAINMENU MENU
BEGIN
    POPUP "&Cài đặt"
    BEGIN
        MENUITEM "&Thư viện...", IDM_SETTINGS_LIBRARY
        POPUP "Khi bấm &X"
        BEGIN
            MENUITEM "&Hỏi", IDM_CLOSE_ASK
            MENUITEM "&Thoát", IDM_CLOSE_EXIT
            MENUITEM "Xuống &khay", IDM_CLOSE_TRAY
            MENUITEM SEPARATOR
            MENUITEM "Thu nhỏ &cũng xuống khay", IDM_MIN_TO_TRAY
        END
    END
END

IDD_LIBRARY DIALOGEX 0, 0, 260, 140
STYLE DS_MODALFRAME | DS_SHELLFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Cài đặt thư viện"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Thư mục sách bổ sung (ngoài thư mục ebooks):", -1, 7, 7, 246, 8
    LISTBOX IDC_ROOT_LIST, 7, 19, 190, 80, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_BORDER | WS_TABSTOP
    PUSHBUTTON "&Thêm...", IDC_ROOT_ADD, 203, 19, 50, 14
    PUSHBUTTON "&Xóa", IDC_ROOT_REMOVE, 203, 37, 50, 14
    AUTOCHECKBOX "&Quét khi khởi động", IDC_SCAN_ON_START, 7, 106, 150, 10
    PUSHBUTTON "&Hiện lại sách đã ẩn", IDC_UNHIDE, 7, 119, 100, 14
    DEFPUSHBUTTON "OK", IDOK, 143, 119, 50, 14
    PUSHBUTTON "Hủy", IDCANCEL, 203, 119, 50, 14
END

IDD_READER_SETTINGS DIALOGEX 0, 0, 260, 240
STYLE DS_MODALFRAME | DS_SHELLFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Giao diện và phông chữ"
FONT 9, "Segoe UI"
BEGIN
    GROUPBOX "Giao diện", -1, 7, 5, 246, 112
    AUTORADIOBUTTON "&Trắng", IDC_THEME_WHITE, 14, 18, 66, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Đ&en", IDC_THEME_BLACK, 14, 31, 66, 10
    AUTORADIOBUTTON "&Giấy sách", IDC_THEME_PAPER, 14, 44, 66, 10
    AUTORADIOBUTTON "Tự &chỉnh", IDC_THEME_CUSTOM, 14, 57, 66, 10
    LTEXT "Nền", -1, 90, 19, 40, 8
    CONTROL "", IDC_SWATCH_BG, "Static", SS_LEFT | SS_SUNKEN, 130, 17, 24, 12
    PUSHBUTTON "Đổi màu…", IDC_PICK_BG, 160, 16, 60, 14
    LTEXT "Chữ", -1, 90, 35, 40, 8
    CONTROL "", IDC_SWATCH_FG, "Static", SS_LEFT | SS_SUNKEN, 130, 33, 24, 12
    PUSHBUTTON "Đổi màu…", IDC_PICK_FG, 160, 32, 60, 14
    LTEXT "Liên kết", -1, 90, 51, 40, 8
    CONTROL "", IDC_SWATCH_LINK, "Static", SS_LEFT | SS_SUNKEN, 130, 49, 24, 12
    PUSHBUTTON "Đổi màu…", IDC_PICK_LINK, 160, 48, 60, 14
    LTEXT "Tô sáng", -1, 90, 67, 40, 8
    CONTROL "", IDC_SWATCH_HL, "Static", SS_LEFT | SS_SUNKEN, 130, 65, 24, 12
    PUSHBUTTON "Đổi màu…", IDC_PICK_HL, 160, 64, 60, 14
    AUTOCHECKBOX "&Không đổi màu ảnh/truyện tranh", IDC_KEEP_IMAGES, 14, 90, 230, 10, WS_TABSTOP
    LTEXT "Chỉ áp dụng cho truyện tranh CBZ; PDF luôn đổi màu khi không dùng nền trắng.", -1, 24, 102, 224, 8
    GROUPBOX "Phông chữ", -1, 7, 122, 246, 92
    AUTORADIOBUTTON "Theo &sách", IDC_FONT_BOOK, 14, 135, 66, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Ghi đè &font", IDC_FONT_FAMILY_ONLY, 14, 148, 66, 10
    AUTORADIOBUTTON "Ghi đè &hết", IDC_FONT_ALL, 14, 161, 66, 10
    LTEXT "Font", -1, 90, 136, 60, 8
    COMBOBOX IDC_FONT_FAMILY, 160, 134, 87, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Cỡ chữ (pt)", -1, 90, 153, 60, 8
    EDITTEXT IDC_FONT_SIZE, 160, 151, 30, 12, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL "", IDC_FONT_SIZE_SPIN, "msctls_updown32", 0xB6, 190, 151, 10, 12
    LTEXT "Giãn dòng", -1, 90, 169, 60, 8
    COMBOBOX IDC_FONT_LINE, 160, 167, 40, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Lề (pt)", -1, 90, 185, 60, 8
    EDITTEXT IDC_FONT_MARGIN, 160, 183, 30, 12, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL "", IDC_FONT_MARGIN_SPIN, "msctls_updown32", 0xB6, 190, 183, 10, 12
    DEFPUSHBUTTON "OK", IDOK, 143, 220, 50, 14
    PUSHBUTTON "Hủy", IDCANCEL, 203, 220, 50, 14
END
